# Auditi Backend

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/audit_db
DEBUG=false
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Encryption key for LLM connection API keys (must be consistent across restarts)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT secret for user session tokens (must be consistent across restarts)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
